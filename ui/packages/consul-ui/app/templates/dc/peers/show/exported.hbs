<Route @name={{this.routeName}} as |route|>
  <DataLoader
    @src={{uri
      "/${partition}/${nspace}/${dc}/exported-services/${name}"
      (hash
        partition=route.params.partition
        nspace=route.params.nspace
        dc=route.params.dc
        name=route.model.peer.Name
      )
    }}
  >
    <:error as |api|>
      <AppError @error={{api.error}} @login={{route.model.app.login.open}} />
    </:error>

    <:loaded as |api|>
      {{#let
        (or route.params.partition route.model.user.token.Partition "default")
        api.data
        as |partition items|
      }}
        <DataCollection
          @type="service"
          @search={{this.search}}
          @items={{items}}
          as |collection|
        >
          <collection.Collection>
            <Consul::Peer::Exported::List
              @items={{collection.items}}
              @partition={{partition}}
            >
              <:toolbar>
                <Consul::Peer::Exported::Toolbar
                  @search={{this.search}}
                  @onsearch={{action (mut this.search) value="target.value"}}
                />
              </:toolbar>
            </Consul::Peer::Exported::List>
          </collection.Collection>
          <collection.Empty>
            <EmptyState
              @login={{route.model.app.login.open}}
              data-test-exported-services-empty
            >
              <:header>
                <h2>
                  {{t
                    "routes.dc.peers.show.exported.empty.header"
                    name=route.model.peer.Name
                  }}
                </h2>
              </:header>
              <:body>
                {{t
                  "routes.dc.peers.show.exported.empty.body"
                  items=items.length
                  name=route.model.peer.Name
                  htmlSafe=true
                }}
              </:body>
              <:actions>
                <li>
                  <Hds::Link::Standalone
                    @text='Documentation on Peers'
                    @href="{{env
                      'CONSUL_DOCS_URL'
                    }}/connect/cluster-peering"
                    @icon='docs-link'
                    @iconPosition='trailing'
                    @size='small'
                  />
                </li>
                <li>
                  <Hds::Link::Standalone
                    @text='Take the tutorial'
                    @href="{{env
                      'CONSUL_DOCS_URL'
                    }}/connect/cluster-peering/create-manage-peering"
                    @icon='learn-link'
                    @iconPosition='trailing'
                    @size='small'
                  />
                </li>
              </:actions>
            </EmptyState>
          </collection.Empty>
        </DataCollection>
      {{/let}}
    </:loaded>
  </DataLoader>

</Route>

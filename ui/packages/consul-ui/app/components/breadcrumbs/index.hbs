{{#if @items.length}}
  <Hds::Breadcrumb data-test-breadcrumb-list>
    {{#each @items as |item|}}
      {{#if item.isCurrent}}
        <Hds::Breadcrumb::Item
          @text={{item.label}}
          @current={{true}}
          data-test-breadcrumb-item
          data-test-breadcrumb-current
        />
      {{else}}
        <Hds::Breadcrumb::Item
          @text={{item.label}}
          @route={{item.route}}
          data-test-breadcrumb-item
        />
      {{/if}}
    {{/each}}
  </Hds::Breadcrumb>
{{/if}}

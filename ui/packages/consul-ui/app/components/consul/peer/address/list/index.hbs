<div class="consul-peer-address-list" ...attributes>
  <Consul::DataTable
    @items={{@items}}
    @columns={{this.columns}}
    @ariaLabel="Server Addresses"
    @card={{true}}
  >
    <:toolbar>
      {{yield to="toolbar"}}
    </:toolbar>
    <:row as |item B|>
      <B.Td>
        <span class="consul-peer-address-list__address">
          {{item}}
          <Hds::Copy::Button
            @textToCopy={{item}}
            @text="Copy address"
            @isIconOnly={{true}}
            @size="small"
            data-test-copy-address
          />
        </span>
      </B.Td>
    </:row>
  </Consul::DataTable>
</div>

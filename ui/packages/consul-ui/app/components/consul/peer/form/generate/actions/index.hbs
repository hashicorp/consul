<Hds::ButtonSet ...attributes>
  <Consul::Peer::Form::Cancel
    @dirty={{or @item.Name @item.ServerExternalAddresses}}
    @onconfirm={{@onCancel}}
  />
  <Hds::Button
    @text='Generate token'
    form={{@id}}
    type='submit'
    disabled={{not @item.Name}}
  />
</Hds::ButtonSet>
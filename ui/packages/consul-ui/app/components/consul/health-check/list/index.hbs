<div
  class="consul-health-check-list"
  ...attributes
>
  <ul>
{{#each @items as |item|}}
    <li class={{concat 'health-check-output ' item.Status}}>
      <div>
        <div class="health-check-output__title">
          <span class="health-check-output__name">{{item.Name}}</span>
{{#if (eq item.Status "passing")}}
          <Hds::Badge @text="Passing" @icon="check" @color="success" @type="filled" @size="small" data-test-health-check-status={{item.Status}} />
{{else if (eq item.Status "warning")}}
          <Hds::Badge @text="Warning" @icon="alert-triangle" @color="warning" @type="filled" @size="small" data-test-health-check-status={{item.Status}} />
{{else if (eq item.Status "critical")}}
          <Hds::Badge @text="Critical" @icon="x" @color="critical" @type="filled" @size="small" data-test-health-check-status={{item.Status}} />
{{else}}
          <Hds::Badge @text={{item.Status}} @color="neutral" @type="outlined" @size="small" data-test-health-check-status={{item.Status}} />
{{/if}}
        </div>
        <dl>
        {{#if (eq item.Kind "node")}}
          <dt>Node name</dt>
          <dd>{{item.Node}}</dd>
        {{else}}
          <dt>Service name</dt>
          <dd>{{item.ServiceName}}</dd>
        {{/if}}
        </dl>
        <dl>
          <dt>Check ID</dt>
          <dd>{{or item.CheckID '-'}}</dd>
        </dl>
        <dl>
          <dt>Type</dt>
          <dd data-health-check-type>
            {{item.Type}}
  {{#if item.Exposed}}
            <span
              class="consul-health-check-list__exposed-badge"
              data-test-exposed="true"
              {{hds-tooltip "Expose.checks is set to true, so all registered HTTP and gRPC check paths are exposed through Envoy for the Consul agent." options=(detached-tooltip-options)}}
            >
              <Hds::Badge
                @text="Exposed"
                @color="neutral"
                @type="filled"
                @size="small"
              />
            </span>
  {{/if}}
          </dd>
        </dl>
        <dl>
          <dt>Notes</dt>
          <dd>{{or item.Notes '-'}}</dd>
        </dl>
        <dl>
          <dt>Output</dt>
          <dd>
              <ConsulCopyButton @value={{item.Output}} @name="output" />
              <pre><code>{{item.Output}}</code></pre>
          </dd>
        </dl>
      </div>
    </li>
{{/each}}
  </ul>
</div>

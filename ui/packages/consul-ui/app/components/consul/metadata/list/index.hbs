<Hds::Card::Container
  data-test-metadata
  @level="mid"
  @hasBorder={{true}}
  @overflow="hidden"
  class="consul-metadata-list"
>
  <dl class="consul-metadata-list__grid">
    <div class="consul-metadata-list__head">Key</div>
    <div class="consul-metadata-list__head">Value</div>
    {{#each @items as |item|}}
      <dt data-test-metadata-key>{{object-at 0 item}}</dt>
      <dd data-test-metadata-value>{{object-at 1 item}}</dd>
    {{/each}}
  </dl>
</Hds::Card::Container>

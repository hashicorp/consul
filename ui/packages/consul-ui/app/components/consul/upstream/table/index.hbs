<div class="consul-upstream-table" ...attributes>
  <Consul::DataTable
    @items={{@items}}
    @columns={{this.columns}}
    @ariaLabel="Upstreams"
    @card={{@card}}
  >
    <:row as |item B|>
      {{! ---- Service name ---- }}
      <B.Td>
        <span class="consul-upstream-table__name">
          {{#if (gt item.InstanceCount 0)}}
            <a
              data-test-service-name
              href={{href-to "dc.services.show.index" item.Name params=(this.linkParams item)}}
            >
              {{item.Name}}
            </a>
          {{else}}
            <span data-test-service-name>{{item.Name}}</span>
          {{/if}}
          {{#if (gt item.Tags.length 0)}}
            <Hds::RichTooltip class="consul-upstream-table__tags" as |RT|>
              <RT.Toggle
                class="consul-upstream-table__tags-toggle"
                @isInline={{true}}
                aria-label="Show tags"
                data-test-service-tags
              >
                <Hds::Icon @name="tag" @isInline={{true}} />
              </RT.Toggle>
              <RT.Bubble @placement="top">
                <div class="consul-upstream-table__tags-tooltip">
                  <Hds::Text::Body
                    @tag="p"
                    @size="200"
                    @weight="semibold"
                    class="consul-upstream-table__tags-tooltip-title"
                  >
                    Tags:
                  </Hds::Text::Body>
                  <div class="consul-upstream-table__tags-tooltip-list">
                    {{#each item.Tags as |tag|}}
                      <Hds::Tag @text={{tag}} />
                    {{/each}}
                  </div>
                </div>
              </RT.Bubble>
            </Hds::RichTooltip>
          {{/if}}
        </span>
        <Consul::Bucket::List
          @item={{item}}
          @nspace={{@nspace}}
          @partition={{@partition}}
        />
      </B.Td>

      {{! ---- Health ---- }}
      <B.Td data-test-service-health={{item.MeshStatus}}>
        {{#if (eq item.MeshStatus "empty")}}
          <span>No service checks</span>
        {{else if (eq item.MeshStatus "passing")}}
          <Hds::Badge
            @text="All checks passing"
            @icon="check"
            @color="success"
            @type="filled"
            @size="small"
            role="group"
            tabindex="-1"
            aria-label="All checks passing"
            {{hds-tooltip item.healthTooltipText options=(detached-tooltip-options)}}
          />
        {{else if (eq item.MeshStatus "critical")}}
          <Hds::Badge
            @icon="x"
            @color="critical"
            @type="filled"
            @size="small"
            @text={{if
              (eq item.MeshChecksPassing 0)
              "All checks failing"
              (concat item.MeshChecksCritical "/" item.MeshChecksTotal " checks failing")
            }}
            role="group"
            tabindex="-1"
            aria-label={{if
              (eq item.MeshChecksPassing 0)
              "All checks failing"
              (concat item.MeshChecksCritical "/" item.MeshChecksTotal " checks failing")
            }}
            {{hds-tooltip item.healthTooltipText options=(detached-tooltip-options)}}
          />
        {{else if (eq item.MeshStatus "warning")}}
          <Hds::Badge
            @icon="alert-triangle"
            @color="warning"
            @type="filled"
            @size="small"
            @text={{concat item.MeshChecksWarning "/" item.MeshChecksTotal " checks failing"}}
            role="group"
            tabindex="-1"
            aria-label={{concat item.MeshChecksWarning "/" item.MeshChecksTotal " checks failing"}}
            {{hds-tooltip item.healthTooltipText options=(detached-tooltip-options)}}
          />
        {{else}}
          <Hds::Badge
            @text="Unknown"
            @icon="help"
            @color="neutral"
            @type="outlined"
            @size="small"
            role="group"
            tabindex="-1"
            aria-label="Unknown"
            {{hds-tooltip item.healthTooltipText options=(detached-tooltip-options)}}
          />
        {{/if}}
      </B.Td>

      {{! ---- Address ---- }}
      <B.Td data-test-upstream-address>
        {{#if (gt item.GatewayConfig.Addresses.length 0)}}
          <div class="consul-upstream-table__addresses">
            {{#each item.GatewayConfig.Addresses as |address|}}
              <span class="consul-upstream-table__address">
                {{address}}
                <ConsulCopyButton
                  @value={{address}}
                  @name="Address"
                />
              </span>
            {{/each}}
          </div>
        {{else}}
          -
        {{/if}}
      </B.Td>
    </:row>
  </Consul::DataTable>
</div>

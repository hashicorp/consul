<div class="consul-upstream-table" ...attributes>
  <Consul::DataTable
    @items={{@items}}
    @columns={{this.columns}}
    @ariaLabel="Upstreams"
    @card={{@card}}
  >
    <:row as |item B|>
      {{! ---- Service name ---- }}
      <B.Td>
        <span class="consul-upstream-table__name">
          {{#if (gt item.InstanceCount 0)}}
            <a
              data-test-service-name
              href={{href-to "dc.services.show.index" item.Name params=(this.linkParams item)}}
            >
              {{item.Name}}
            </a>
          {{else}}
            <span data-test-service-name>{{item.Name}}</span>
          {{/if}}
          {{#if (gt item.Tags.length 0)}}
            <Hds::RichTooltip class="consul-upstream-table__tags" as |RT|>
              <RT.Toggle
                class="consul-upstream-table__tags-toggle"
                @isInline={{true}}
                aria-label="Show tags"
                data-test-service-tags
              >
                <Hds::Icon @name="tag" @isInline={{true}} />
              </RT.Toggle>
              <RT.Bubble @placement="top">
                <div class="consul-upstream-table__tags-tooltip">
                  <Hds::Text::Body
                    @tag="p"
                    @size="200"
                    @weight="semibold"
                    class="consul-upstream-table__tags-tooltip-title"
                  >
                    Tags:
                  </Hds::Text::Body>
                  <div class="consul-upstream-table__tags-tooltip-list">
                    {{#each item.Tags as |tag|}}
                      <Hds::Tag @text={{tag}} />
                    {{/each}}
                  </div>
                </div>
              </RT.Bubble>
            </Hds::RichTooltip>
          {{/if}}
        </span>
        <Consul::Bucket::List
          @item={{item}}
          @nspace={{@nspace}}
          @partition={{@partition}}
        />
      </B.Td>

      {{! ---- Health ---- }}
      <B.Td data-test-service-health={{item.MeshStatus}}>
        <Consul::HealthBadge
          @status={{item.MeshStatus}}
          @tooltip={{item.healthTooltipText}}
        />
      </B.Td>

      {{! ---- Address ---- }}
      <B.Td data-test-upstream-address>
        {{#if (gt item.GatewayConfig.Addresses.length 0)}}
          <div class="consul-upstream-table__addresses">
            {{#each item.GatewayConfig.Addresses as |address|}}
              <span class="consul-upstream-table__address">
                {{address}}
                <ConsulCopyButton
                  @value={{address}}
                  @name="Address"
                />
              </span>
            {{/each}}
          </div>
        {{else}}
          -
        {{/if}}
      </B.Td>
    </:row>
  </Consul::DataTable>
</div>

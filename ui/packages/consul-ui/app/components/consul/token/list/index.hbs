<div class="consul-token-list" ...attributes>
  <Consul::DataTable
    @items={{@items}}
    @columns={{this.columns}}
    @ariaLabel="Tokens"
  >
    <:row as |item B|>
      {{! ---- Name ---- }}
      <B.Td>
        <span class="consul-token-list__name">
          {{#if (eq item.AccessorID @token.AccessorID)}}
            <span
              class="consul-token-list__me"
              {{hds-tooltip "Your token" options=(detached-tooltip-options placement="top-start")}}
            ></span>
          {{/if}}
          <a
            data-test-token={{item.AccessorID}}
            data-test-name
            href={{href-to 'dc.acls.tokens.edit' item.AccessorID}}
          >
            {{#if item.Name}}{{truncate item.Name 100}}{{else}}{{substr item.AccessorID -8}}{{/if}}
          </a>
          {{! Management badge stays under the name (global-management star badge) }}
          {{#let (policy/group (or item.Policies item.ACLs.PolicyDefaults (array))) as |grouped|}}
            {{#each grouped.management as |policy|}}
              <Consul::Acl::RulesetBadge
                @item={{policy}}
                @type={{policy/typeof policy}}
                data-test-policy
              />
            {{/each}}
          {{/let}}
        </span>
      </B.Td>

      {{! ---- Identities ---- }}
      <B.Td>
        <span class="consul-token-list__badges" data-test-identities>
          {{#let (policy/group (or item.Policies item.ACLs.PolicyDefaults (array))) as |grouped|}}
            {{#each grouped.identities as |policy|}}
              <Consul::Acl::RulesetBadge
                @item={{policy}}
                @type={{policy/typeof policy}}
                data-test-policy
              />
            {{/each}}
          {{/let}}
        </span>
      </B.Td>

      {{! ---- Rules-policies ---- }}
      <B.Td>
        <span class="consul-token-list__badges" data-test-rules-policies>
          {{#if (token/is-legacy item)}}
            <em class="consul-token-list__legacy-rules">Legacy rules</em>
          {{else}}
            {{#let (policy/group (or item.Policies item.ACLs.PolicyDefaults (array))) as |grouped|}}
              {{#each grouped.policies as |policy|}}
                <Consul::Acl::RulesetBadge
                  @item={{policy}}
                  @type={{policy/typeof policy}}
                  data-test-policy
                />
              {{/each}}
            {{/let}}
          {{/if}}
        </span>
      </B.Td>

      {{! ---- Rules-roles ---- }}
      <B.Td>
        <span class="consul-token-list__badges" data-test-rules-roles>
          {{#each (or item.Roles item.ACLs.RoleDefaults (array)) as |role|}}
            <Consul::Acl::RulesetBadge
              @item={{role}}
              @type={{policy/typeof role}}
              data-test-policy
            />
          {{/each}}
        </span>
      </B.Td>

      {{! ---- Scope ---- }}
      <B.Td>{{if item.Local 'local' 'global'}}</B.Td>

      {{! ---- Description ---- }}
      <B.Td>
        <em class="consul-token-list__description" data-test-description>
          {{item.Description}}
        </em>
      </B.Td>

      {{! ---- Secret ---- }}
      <B.Td>
        {{#if item.hasSecretID}}
          <ConsulCopyButton @value={{item.SecretID}} @name={{t 'components.consul.token.secretID'}}>
            {{t 'components.consul.token.secretID'}}
          </ConsulCopyButton>
        {{/if}}
      </B.Td>

      {{! ---- Actions ---- }}
      <B.Td @align="right">
        <Hds::Dropdown @listPosition="bottom-right" class="consul-token-list__actions" as |dd|>
          <dd.ToggleIcon
            @icon="more-horizontal"
            @text="Open actions menu"
            @hasChevron={{false}}
            @size="small"
            data-test-actions-menu
          />
          <dd.Interactive
            @icon={{if (can 'write token' item=item) 'edit' 'eye'}}
            @route='dc.acls.tokens.edit'
            @model={{item.AccessorID}}
            data-test-edit
          >
            {{#if (can 'write token' item=item)}}Edit{{else}}View{{/if}}
          </dd.Interactive>
          {{#if (can 'duplicate token' item=item)}}
            <dd.Interactive @icon="duplicate" data-test-clone {{on 'click' (fn @onclone item)}}>Duplicate</dd.Interactive>
          {{/if}}
          {{#if (eq item.AccessorID @token.AccessorID)}}
            <dd.Interactive @color="critical" @icon="sign-out" data-test-logout {{on 'click' (fn this.confirm 'logout' item)}}>Logout</dd.Interactive>
          {{else}}
            <dd.Interactive @icon="sign-in" data-test-use {{on 'click' (fn this.confirm 'use' item)}}>Use</dd.Interactive>
          {{/if}}
          {{#if (can 'delete token' item=item token=@token)}}
            <dd.Separator />
            <dd.Interactive @color="critical" @icon="trash" data-test-delete {{on 'click' (fn this.confirm 'delete' item)}}>Delete</dd.Interactive>
          {{/if}}
        </Hds::Dropdown>
      </B.Td>
    </:row>
  </Consul::DataTable>

  {{#if this.itemToConfirm}}
    <Hds::Modal id="confirm-modal" @color={{if (eq this.confirmType 'delete') 'critical' 'warning'}} @onClose={{this.cancelConfirm}} as |M|>
      <M.Header @icon={{if (eq this.confirmType 'delete') 'trash' 'alert-triangle'}}>
        {{#if (eq this.confirmType 'use')}}Confirm use{{else if (eq this.confirmType 'logout')}}Confirm logout{{else}}Confirm delete{{/if}}
      </M.Header>
      <M.Body>
        {{#if (eq this.confirmType 'use')}}
          <p>Are you sure you want to use this ACL token?</p>
        {{else if (eq this.confirmType 'logout')}}
          <p>Are you sure you want to stop using this ACL token? This will log you out.</p>
        {{else}}
          <p>Are you sure you want to delete this token?</p>
        {{/if}}
      </M.Body>
      <M.Footer as |F|>
        <Hds::ButtonSet>
          <Hds::Button
            @text={{if (eq this.confirmType 'use') 'Use' (if (eq this.confirmType 'logout') 'Logout' 'Delete')}}
            @color={{if (eq this.confirmType 'delete') 'critical' 'primary'}}
            data-test-id="confirm-action"
            {{on 'click' this.invokeConfirm}}
          />
          <Hds::Button @text="Cancel" @color="secondary" {{on 'click' F.close}} />
        </Hds::ButtonSet>
      </M.Footer>
    </Hds::Modal>
  {{/if}}
</div>

{{!
  Structure rendered by Consul::DataTable:
    .consul-data-table__card  (card: border + rounded corners)
      :toolbar block  →  Consul::Node::Toolbar
      .consul-data-table__viewport  →  the scrollable table
    Hds::Pagination  (outside the card, owned by Consul::DataTable)
}}
<Consul::DataTable
  @items={{@items}}
  @columns={{this.columns}}
  @ariaLabel="Nodes"
  class="consul-node-table"
  ...attributes
>
  <:row as |item B|>
    {{! ---- Node name ---- }}
    <B.Td>
      <span class="consul-node-table__name">
        <a data-test-node href={{href-to "dc.nodes.show" item.Node params=(hash peer=item.PeerName)}}>
          {{item.Node}}
        </a>
        <Consul::Node::PeerInfo @item={{item}} />
        {{#if (eq item.Address @leader.Address)}}
          <span class="consul-node-table__leader-badge" data-test-leader={{@leader.Address}}>
            <Hds::Badge
              @text="Leader"
              @icon="star-fill"
              @color="neutral"
              @type="filled"
              @size="small"
            />
          </span>
        {{/if}}
      </span>
    </B.Td>

    {{! ---- Health ---- }}
    <B.Td>
      {{#if (eq item.Status "passing")}}
        <Hds::Badge
          @text="Passing"
          @icon="check"
          @color="success"
          @type="filled"
          @size="small"
          {{hds-tooltip (this.healthTooltip item.Status) options=(detached-tooltip-options)}}
          data-test-status={{item.Status}}
        />
      {{else if (eq item.Status "warning")}}
        <Hds::Badge
          @text="Warning"
          @icon="alert-triangle"
          @color="warning"
          @type="filled"
          @size="small"
          {{hds-tooltip (this.healthTooltip item.Status) options=(detached-tooltip-options)}}
          data-test-status={{item.Status}}
        />
      {{else if (eq item.Status "critical")}}
        <Hds::Badge
          @text="Critical"
          @icon="x"
          @color="critical"
          @type="filled"
          @size="small"
          {{hds-tooltip (this.healthTooltip item.Status) options=(detached-tooltip-options)}}
          data-test-status={{item.Status}}
        />
      {{else}}
        <Hds::Badge
          @text="No health checks"
          @icon="help"
          @color="neutral"
          @type="outlined"
          @size="small"
          {{hds-tooltip (this.healthTooltip item.Status) options=(detached-tooltip-options)}}
          data-test-status={{item.Status}}
        />
      {{/if}}
    </B.Td>

    {{! ---- Address ---- }}
    <B.Td>
      <span class="consul-node-table__address" data-test-node-address>
        {{format-ipaddr item.Address}}
        <ConsulCopyButton @value={{item.Address}} @name="Address" />
      </span>
    </B.Td>

    {{! ---- Version ---- }}
    <B.Td>
      {{#if item.Version}}
        <span class="consul-node-table__version" data-test-node-version>
          <Hds::Icon @name="consul-color" @isInline={{true}} />
          <span>v{{item.Version}}</span>
        </span>
      {{/if}}
    </B.Td>

    {{! ---- Services ---- }}
    <B.Td>
      <Hds::Badge
        @text={{format-number item.MeshServiceInstances.length}}
        @color="neutral"
        @type="outlined"
        @size="small"
        data-test-node-services
      />
    </B.Td>
  </:row>
</Consul::DataTable>

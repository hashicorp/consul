<div class="consul-auth-method-nspace-list">
  <Hds::Table>
    <:head as |H|>
      <H.Tr>
        <H.Th>{{t "models.auth-method.Selector"}}</H.Th>
        <H.Th>{{t "models.auth-method.BindNamespace"}}</H.Th>
      </H.Tr>
    </:head>
    <:body as |B|>
      {{#each @items as |item|}}
      <B.Tr>
        <B.Td>{{item.Selector}}</B.Td>
        <B.Td>{{item.BindNamespace}}</B.Td>
      </B.Tr>
      {{/each}}
    </:body>
  </Hds::Table>
</div>

{{yield}}
<div class='consul-policy-form' ...attributes>
  <Consul::Policy::Fieldsets
    @item={{this.item}}
    @create={{true}}
    @name={{this.name}}
    @allowIdentity={{this.allowIdentity}}
    @dc={{@dc}}
    @partition={{@partition}}
    @nspace={{@nspace}}
    @onChange={{action 'change'}}
  />
</div>
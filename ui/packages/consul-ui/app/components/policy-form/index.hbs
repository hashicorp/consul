{{yield}}
<div
  class='consul-policy-form'
  {{fix-code-block-aria}}
  {{fix-super-select-aria}}
  ...attributes
>
  <Consul::Policy::Fieldsets
    @item={{this.item}}
    @create={{true}}
    @name={{this.name}}
    @allowIdentity={{this.allowIdentity}}
    @dc={{@dc}}
    @partition={{@partition}}
    @nspace={{@nspace}}
    @onChange={{action 'change'}}
  />
</div>
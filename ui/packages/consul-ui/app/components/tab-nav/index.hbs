{{#each (array this.tabsKey) key="@identity"}}
  <Hds::Tabs
    @size="large"
    @selectedTabIndex={{this.selectedTabIndex}}
    @onClickTab={{this.onClickTab}}
    ...attributes
    as |T|
  >
    {{#each @items as |item|}}
      <T.Tab
        @isSelected={{item.selected}}
        data-test-tab={{concat 'tab_' (if item.label (slugify item.label) (slugify item))}}
      >
        {{#if item.tooltip}}
          <span tabindex="-1" {{hds-tooltip item.tooltip options=(detached-tooltip-options)}}>
            {{item.label}}
          </span>
        {{else}}
          {{item.label}}
        {{/if}}
      </T.Tab>
    {{/each}}

    {{! Route and state content remains owned by callers, but HDS requires one panel per tab. }}
    {{#each @items}}
      <T.Panel />
    {{/each}}
  </Hds::Tabs>
{{/each}}

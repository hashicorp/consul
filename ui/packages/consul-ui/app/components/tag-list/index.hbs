{{#let (union (or @item.Tags (array)) (or @tags (array))) as |tags|}}
  {{#if (gt tags.length 0)}}
    {{#if (has-block)}}
      {{yield
        (component 'tag-list' item=@item)
      }}
    {{else}}
<Hds::Card::Container
  @level="mid"
  @hasBorder={{true}}
  @overflow="hidden"
  class="tag-list"
  ...attributes
>
  <div class="tag-list__tags" data-test-tags>
    {{#each tags as |item|}}
      <Hds::Tag @text={{item}} />
    {{/each}}
  </div>
</Hds::Card::Container>
    {{/if}}
  {{/if}}
{{/let}}

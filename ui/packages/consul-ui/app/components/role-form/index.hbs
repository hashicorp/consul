{{yield}}
<fieldset
  class='role-form'
  aria-label='Role details'
  disabled={{if (not (can 'write role' item=this.item)) 'disabled'}}
  ...attributes
>
  <Hds::Form::TextInput::Field
    @value={{this.item.Name}}
    @isInvalid={{if this.item.error.Name true false}}
    name='role[Name]'
    placeholder='Enter role name here'
    {{on 'input' (action 'change')}}
    {{on 'keydown' (action this.preventParentSubmit)}}
    as |F|
  >
    <F.Label>Name</F.Label>
    <F.HelperText>
      Maximum 256 characters. May only include letters (uppercase and/or lowercase) and/or numbers.
      Must be unique.
    </F.HelperText>
    {{#if this.item.error.Name}}
      <F.Error>{{this.item.error.Name.validation}}</F.Error>
    {{/if}}
  </Hds::Form::TextInput::Field>
  <Hds::Form::Textarea::Field
    @value={{this.item.Description}}
    @isOptional={{true}}
    name='role[Description]'
    placeholder='Enter description here'
    {{on 'input' (action 'change')}}
    as |F|
  >
    <F.Label>Description</F.Label>
  </Hds::Form::Textarea::Field>
</fieldset>
<fieldset class='role-form__policies' aria-label='Role policies'>
  {{#if (has-block 'policy')}}
    {{yield this.item to='policy'}}
  {{else}}
    <PolicySelector
      @showHeader={{true}}
      @title='Role policies'
      @disabled={{not (can 'write role' item=this.item)}}
      @dc={{@dc}}
      @partition={{@partition}}
      @nspace={{@nspace}}
      @items={{this.item.Policies}}
    />
  {{/if}}
</fieldset>
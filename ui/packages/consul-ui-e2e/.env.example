# Copy to `.env` and adjust. All values have sensible defaults; override as needed.

# Which Consul edition the run tests: ce (default) or ent. Tests tagged @ent run
# only on ent, @ce only on ce. The agent binary/image must match.
EDITION=ce

# docker (default) | local  — how the Consul agent is launched.
RUNTIME=docker

# Path to the consul-ui Ember app (UI_SOURCE=ember). Playwright starts its dev server from here.
CONSUL_UI_DIR=../consul-ui

# Which UI is under test:
#   ember (default) — Playwright starts the consul-ui Ember dev server on :4200.
#   agent           — the UI served by the agent on :8500 (a Consul binary built
#                     with the UI embedded, e.g. `make ui-regen && make dev`). CI uses this.
UI_SOURCE=ember

# Base URL Playwright drives. Leave unset: it follows UI_SOURCE
# (http://localhost:4200 for ember, the agent on http://127.0.0.1:8500 for agent).
# E2E_BASE_URL=

# The consul binary every scenario uses when RUNTIME=local. For EDITION=ent,
# point it at an Enterprise binary and set its license file. With
# UI_SOURCE=agent it must be a path (e.g. ../../../bin/consul), not PATH lookup.
CONSUL_BIN=consul
CONSUL_LICENSE_PATH=

# The image every scenario uses when RUNTIME=docker, e.g. `make dev-docker` →
# consul:local. Defaults to a CE image (or an Enterprise one for ent scenarios).
# CONSUL_IMAGE=
# For Enterprise images: the license text itself (never commit it),
# e.g. CONSUL_LICENSE=$(cat your.hclic)
# CONSUL_LICENSE=
